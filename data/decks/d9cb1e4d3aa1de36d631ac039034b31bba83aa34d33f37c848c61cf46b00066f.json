      "width": 1600,
      "height": 900,
      "text": "Focus Core system priorities Protecting trade secrets Securing sensitive data",
      "title": "",
      "original_description_html": "<p>Focus Core system priorities Protecting trade secrets Securing sensitive data</p>\n"
    },
    {
