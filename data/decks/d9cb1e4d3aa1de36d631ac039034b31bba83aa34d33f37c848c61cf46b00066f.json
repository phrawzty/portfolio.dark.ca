      "image": "decks/d9cb1e4d3aa1de36d631ac039034b31bba83aa34d33f37c848c61cf46b00066f/0013.jpg",
      "width": 1600,
      "height": 900,
      "text": "The past: pretty good! Built progressively and from organic needs State of the art, at the time",
      "title": "",
      "original_description_html": "<p>The past: pretty good! Built progressively and from organic needs State of the art, at the time</p>\n"
