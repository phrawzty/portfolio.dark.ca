      "width": 1600,
      "height": 900,
      "text": "The second phase Level-up: new tech, new culture Move faster and safer",
      "title": "",
      "original_description_html": "<p>The second phase Level-up: new tech, new culture Move faster and safer</p>\n"
    },
    {
