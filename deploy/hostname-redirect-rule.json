{
  "description": "speaking.dark.ca to canonical portfolio.dark.ca",
  "expression": "(http.host eq \"speaking.dark.ca\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": {
        "expression": "concat(\"https://portfolio.dark.ca\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
