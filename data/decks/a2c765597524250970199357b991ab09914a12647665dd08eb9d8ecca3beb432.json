    },
    {
      "id": "k3FqXc",
      "number": 13,
      "image": "decks/2020-06-23-demystifying-devops-sre-devops-enterprise-summit-london-virtual/slides/013.png",
      "width": 1600,
      "height": 900,
      "text": "DevOps is an idea; SRE is a practice — A cohort of Site Reliability Engineers, organised and managed as a group, form an SRE team. — SRE teams are versatile! — Code reviews, incident reports, facilitate postmortems — Support a dedicate portfolio or a product team — Individual SREs may rotate in and out of projects / sprints (or not!) @phrawzty // Datadog 13",
      "title": ""
    },
    {
      "id": "MMyeQ1",
      "number": 14,
      "image": "decks/2020-06-23-demystifying-devops-sre-devops-enterprise-summit-london-virtual/slides/014.png",
      "width": 1600,
      "height": 900,
      "text": "Topics 1. Clear up confusion about DevOps and SRE mean. 2. Discuss team and organisational structure. 3. Tips on finding and growing SRE talent. 4. Practical suggestions—and pitfalls! @phrawzty // Datadog 14",
      "title": ""
    },
    {
      "id": "yghSIQ",
      "number": 15,
      "image": "decks/2020-06-23-demystifying-devops-sre-devops-enterprise-summit-london-virtual/slides/015.png",
      "width": 1600,
      "height": 900,
      "text": "SREs have personalities — Patience for staring at code — Enjoy problem-solving — Capacity for self-teaching — Wide range of technical interests — Great at communicating in different ways — Big on teamwork and mutual trust — Interested in mentoring / teaching @phrawzty // Datadog 15",
      "title": ""
    },
    {
      "id": "b0QGAp",
      "number": 16,
      "image": "decks/2020-06-23-demystifying-devops-sre-devops-enterprise-summit-london-virtual/slides/016.png",
      "width": 1600,
      "height": 900,
      "text": "SREs have backgrounds — Traditional “ops” or “dev” profiles — Customer success agent — PhD in computer science — Dropped out of high school Great SRE talent can come from anywhere! @phrawzty // Datadog 16",
      "title": ""
    },
    {
      "id": "DK943E",
      "number": 17,
      "image": "decks/2020-06-23-demystifying-devops-sre-devops-enterprise-summit-london-virtual/slides/017.png",
      "width": 1600,
      "height": 900,
      "text": "Topics 1. Clear up confusion about DevOps and SRE mean. 2. Discuss team and organisational structure. 3. Tips on finding and growing SRE talent. 4. Practical suggestions—and pitfalls! @phrawzty // Datadog 17",
      "title": ""
    },
    {
      "id": "pdrrvd",
      "number": 18,
      "image": "decks/2020-06-23-demystifying-devops-sre-devops-enterprise-summit-london-virtual/slides/018.png",
      "width": 1600,
      "height": 900,
      "text": "SRE: Standalone? Embedded? Other?! — Depends on your organisation and your realities. — Try a few different things—see what works! — This is where the CAMS acronym comes into play. @phrawzty // Datadog 18",
      "title": ""
    },
    {
      "id": "Rxafo2",
      "number": 19,
      "image": "decks/2020-06-23-demystifying-devops-sre-devops-enterprise-summit-london-virtual/slides/019.png",
      "width": 1600,
      "height": 900,
      "text": "Archaeology is the search for fact — not truth. If it’s truth you’re looking for, Dr. Tyree’s philosophy class is right down the hall. — Indiana Jones @phrawzty // Datadog 19",
      "title": ""
    },
