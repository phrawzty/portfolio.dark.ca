      "width": 1600,
      "height": 900,
      "text": "B2B and B2C Historically B2B-focused Today, B2C is growing quickly",
      "title": "",
      "original_description_html": "<p>B2B and B2C Historically B2B-focused Today, B2C is growing quickly</p>\n"
    },
    {
      "id": "6nOhHp",
